# Copy this file to `local.properties` (git-ignored) and adjust it to your machine.
# See docs/web.md §2 for how environments work.

# Android SDK location (Android Studio usually writes this line for you).
# Windows example: sdk.dir=C\:\\Users\\<you>\\AppData\\Local\\Android\\Sdk
# macOS example:   sdk.dir=/Users/<you>/Library/Android/sdk
sdk.dir=

# API environment used at build time: DEV | PROD (or any name with a matching <ENV>_API_URL).
# Override for a single build with: ./gradlew ... -PapiEnv=PROD
# Release builds (Play Store / web deploy) must use PROD.
API_ENV=DEV

DEV_API_URL=https://condominium-api-beta.nibs-tech.com/
PROD_API_URL=https://condominium-api.nibs-tech.com/

# HTTP body logging on Android (OkHttp). Keep false for release builds.
ENABLE_NETWORK_LOGS=true
